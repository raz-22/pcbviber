# ─── Required ───────────────────────────────────────────
# Get these from https://nexar.com/api (sign in with Altium Live)
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# ─── Optional ───────────────────────────────────────────
# Default Altium 365 workspace (can also be passed per-tool-call)
ALTIUM_WORKSPACE_URL=

# For Requirements & Systems Portal REST API
# Generate at: Altium 365 → Settings → User Tokens
ALTIUM_REST_TOKEN=

# ─── HTTP transport (when using --transport=http) ───────
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# ─── SaaS foundations (the internal design spec §2.5) ─
# DATABASE_URL points at Postgres 15+. Local dev: `docker-compose up -d
# postgres` brings up the dev instance documented in docker-compose.yml.
# Tests use TEST_DATABASE_URL (below) — they create / drop schemas
# inside that DB per-test-file, so it must be writable + admin-capable.
DATABASE_URL=postgresql://altium:altium_dev@127.0.0.1:5432/altium_dev
TEST_DATABASE_URL=postgresql://altium:altium_dev@127.0.0.1:5432/altium_test
# 32-byte base64; never commit a real one. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# WorkOS — auth provider + SAML/OIDC SSO (spec §3.1).
#
#   - WORKOS_API_KEY / WORKOS_CLIENT_ID: when both are set, the
#     server selects WorkOSAuthProvider instead of LocalAuth.
#     Sign up at https://workos.com (free tier covers dev).
#   - WORKOS_COOKIE_PASSWORD: session-cookie + SSO-state signing
#     key. 32+ bytes base64. REQUIRED — even LocalAuth uses it for
#     session JWTs. Generate:
#       node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# Per-org SSO setup runbook (Sprint 7 PR 7.3):
#   1. In the WorkOS dashboard, create an SSO connection for the
#      org (Okta / Azure AD / generic SAML/OIDC). Copy the
#      `connection_id` (starts `conn_…`).
#   2. Add `<APP_BASE_URL>/api/auth/sso/callback` to the WorkOS
#      Redirect URIs allowlist.
#   3. Set `Organization.workosConnectionId` for the org via the
#      admin CLI:  pnpm -F @altium-mcp/server admin … (self-service
#      UI lands in PR 7.3b).
#   4. Verify: open /login, click "Sign in with SSO", enter the
#      org slug — browser redirects through WorkOS to the IdP and
#      back.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=

# Public URL the SPA + IdP redirect back to. Must match the
# WorkOS Redirect URI exactly. Defaults to http://127.0.0.1:3000
# (local dev); set to https://app.example.com in prod.
APP_BASE_URL=
# When set, quota counters (search_parts, etc.) live in Redis instead of
# the in-process InMemoryQuotaStore. Required for multi-instance prod.
REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs — set after running the seed script.
# `pnpm -F @altium-mcp/metering seed:plans` upserts Plan rows that link
# Stripe Prices to plan names; the metering resolver looks up plans for
# orgs whose Subscription has a stripePriceId but no planId yet.
STRIPE_PRICE_STARTER_SEAT=
STRIPE_PRICE_TEAM_SEAT=
STRIPE_PRICE_METER_BOM=
STRIPE_PRICE_METER_COST=
STRIPE_PRICE_METER_EXPORT=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
