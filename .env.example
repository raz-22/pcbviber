# ─── Required ───────────────────────────────────────────
# Get these from https://nexar.com/api (sign in with Altium Live)
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# ─── Optional ───────────────────────────────────────────
# Default Altium 365 workspace (can also be passed per-tool-call)
ALTIUM_WORKSPACE_URL=

# For Requirements & Systems Portal REST API
# Generate at: Altium 365 → Settings → User Tokens
ALTIUM_REST_TOKEN=

# ─── HTTP transport (when using --transport=http) ───────
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# ─── SaaS foundations (the internal design spec §2.5) ─
# Sprint 1 needs:
#   DATABASE_URL              — SQLite default works out of the box
#   CREDENTIAL_ENCRYPTION_KEY — 32-byte base64; never commit a real one
# Generate an encryption key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATABASE_URL=file:./altium-mcp.dev.db
CREDENTIAL_ENCRYPTION_KEY=

# Added in later sprints; fine to leave blank in dev:
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
# When set, quota counters (search_parts, etc.) live in Redis instead of
# the in-process InMemoryQuotaStore. Required for multi-instance prod.
REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs — set after running the seed script.
# `pnpm -F @altium-mcp/metering seed:plans` upserts Plan rows that link
# Stripe Prices to plan names; the metering resolver looks up plans for
# orgs whose Subscription has a stripePriceId but no planId yet.
STRIPE_PRICE_STARTER_SEAT=
STRIPE_PRICE_TEAM_SEAT=
STRIPE_PRICE_METER_BOM=
STRIPE_PRICE_METER_COST=
STRIPE_PRICE_METER_EXPORT=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
