{
  "name": "@altium-mcp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./test-utils": {
      "types": "./build/test-utils.d.ts",
      "default": "./build/test-utils.js"
    }
  },
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && tsc",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "test": "cross-env NODE_ENV=test node --test --experimental-test-coverage --test-reporter=spec \"build/**/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.4",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3"
  }
}
