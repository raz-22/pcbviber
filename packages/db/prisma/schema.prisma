// Altium-MCP tenant & billing schema.
//
// Per the internal design spec §2.4. The model is deliberately kept
// narrow for Sprint 1 — only the tables Sprint 1 through Sprint 4 need.
// Row-Level Security notes are in the package README; RLS is enabled
// per-table via a migration hook in Sprint 2.
//
// Dev default is SQLite so the package builds without any external
// service. Production points DATABASE_URL at Postgres 16 and re-runs
// `prisma migrate deploy` — no schema changes required (SQLite-specific
// types are avoided on purpose).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ──────────────────────────────────────────────────────────

model Organization {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  billingCustomerId  String?        // Stripe customer id; set when checkout completes
  planId             String?
  plan               Plan?          @relation(fields: [planId], references: [id])
  /// Source of truth for "what state is this org in for billing purposes".
  /// Distinct from Subscription.status (which is a Stripe-side mirror) so
  /// pre-checkout orgs (no Subscription row yet) still have a state.
  /// Vocab: free | trialing | active | past_due | suspended | canceled
  billingStatus      String         @default("free")
  /// Set on signup when an org enters trial. null otherwise.
  trialEndsAt        DateTime?
  /// "checkout" — uses Stripe Checkout + Customer Portal.
  /// "invoicing" — Enterprise NET-30 via Stripe Invoicing (set manually).
  billingMode        String         @default("checkout")
  createdAt          DateTime       @default(now())
  deletedAt          DateTime?

  memberships        Membership[]
  workspaces         Workspace[]
  apiKeys            ApiKey[]
  subscriptions      Subscription[]
  usageEvents        UsageEvent[]
  invites            Invite[]
  auditLogs          AuditLog[]

  @@index([slug])
  @@index([createdAt])
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  emailVerifiedAt DateTime?
  workosUserId    String?      @unique
  /// Populated only by @altium-mcp/auth's LocalAuthProvider; always null
  /// when WorkOS owns authentication. Format: scrypt$v1$...
  passwordHashLocal String?
  createdAt       DateTime     @default(now())

  memberships     Membership[]
  usageEvents     UsageEvent[]
  auditLogs       AuditLog[]

  @@index([email])
}

model Membership {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  role      String       // owner | admin | member | billing_only
  createdAt DateTime     @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

// ─── Workspaces (per-tenant Nexar credentials, encrypted at rest) ─────

model Workspace {
  id                    String   @id @default(cuid())
  orgId                 String
  altiumWorkspaceUrl    String?
  nexarClientIdEnc      String?  // AES-256-GCM via CREDENTIAL_ENCRYPTION_KEY
  nexarClientSecretEnc  String?
  altiumRestTokenEnc    String?
  createdAt             DateTime @default(now())

  org                   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  defaultForApiKeys     ApiKey[]

  @@index([orgId])
}

// ─── API keys for the MCP transport ───────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  hashedKey  String    @unique  // sha256 of the plaintext; plaintext shown once at creation
  scopes     String    // space-separated scope names; normalize later if needed
  /// Default workspace the MCP transport binds tool calls to when
  /// the call doesn't carry its own workspaceId arg. Optional —
  /// unset means workspace-scoped MCP tools fail with
  /// `api_key_no_workspace` until configured. Validated to belong
  /// to the same orgId at write time. SetNull on workspace delete
  /// so a cascade doesn't take the API key with it.
  defaultWorkspaceId String?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  defaultWorkspace Workspace?   @relation(fields: [defaultWorkspaceId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([hashedKey])
}

// ─── Billing ──────────────────────────────────────────────────────────

model Plan {
  id                String @id @default(cuid())
  name              String @unique   // starter | team | enterprise
  stripeProductId   String?
  seatPriceId       String?
  meterBomPriceId   String?
  meterCostPriceId  String?
  meterExportPriceId String?
  // Quotas stored as JSON-in-string for SQLite portability; migrate to Json on Postgres.
  includedQuotas    String @default("{}")
  seatLimit         Int    @default(0)

  organizations     Organization[]
  subscriptions     Subscription[]
}

model Subscription {
  id                   String        @id @default(cuid())
  orgId                String
  stripeSubId          String?       @unique
  /// Nullable until Plan rows are seeded — the webhook handler records
  /// stripePriceId directly on the row and links to a Plan when one
  /// gets seeded later. Pre-seed orgs read planName / pricing through
  /// stripePriceId-keyed env config instead.
  planId               String?
  /// Stripe Price id this subscription is on (e.g. `price_…`). Set by
  /// the webhook handler from the line_items on the Stripe sub.
  stripePriceId        String?
  seats                Int           @default(1)
  status               String        // trialing | active | past_due | canceled | suspended
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  /// JSON map of metric → Stripe subscription_item id, e.g.
  /// `{"bom_lookup":"si_abc","cost_analysis":"si_def","export":"si_ghi"}`.
  /// Populated by the customer.subscription.updated webhook handler
  /// when the subscription has metered Prices matching
  /// STRIPE_PRICE_METER_BOM/COST/EXPORT env vars. The meter-push job
  /// reads it to know which subscription_item to bill against.
  meterItemIdsJson     String?

  org                  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan                 Plan?         @relation(fields: [planId], references: [id])

  @@index([orgId])
  @@index([status])
}

model UsageEvent {
  id              String    @id @default(cuid())
  orgId           String
  userId          String?
  tool            String    // e.g. "search_parts"
  metric          String    // e.g. "bom_lookup", "cost_analysis", "export"
  quantity        Int       @default(1)
  timestamp       DateTime  @default(now())
  idempotencyKey  String    @unique
  /// Set by the meter-push background job after a successful
  /// `subscription_items.createUsageRecord` call. Rows with null
  /// are pending; the job sweeps them in batches per (orgId, metric).
  pushedToStripeAt DateTime?

  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, timestamp])
  @@index([tool])
  @@index([orgId, pushedToStripeAt])
}

// ─── Membership lifecycle ─────────────────────────────────────────────

model Invite {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

// ─── Stripe webhook idempotency ───────────────────────────────────────
//
// Idempotency table for Stripe webhooks. The handler tries to insert
// a row keyed on stripeEventId before applying the event; a unique-
// constraint failure means the event was already processed and the
// handler returns 200 without re-applying. Stripe retries failed
// webhook deliveries, so every handler must be idempotent — this
// table is what enforces it.

model WebhookEvent {
  id              String   @id @default(cuid())
  /// Stripe `event.id` — the natural idempotency key.
  stripeEventId   String   @unique
  /// `event.type` for cheap "what kind?" queries on the table.
  eventType       String
  receivedAt      DateTime @default(now())

  @@index([eventType, receivedAt])
}

// ─── Audit log (append-only; exports in Sprint 7) ─────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  orgId        String
  actorUserId  String?
  action       String   // signup | login | member.add | workspace.add | api_key.create | etc.
  target       String?  // resource id / slug
  ip           String?
  userAgent    String?
  metadata     String?  // JSON string
  timestamp    DateTime @default(now())

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, timestamp])
  @@index([action])
}
