    "test": "node build.mjs && node test/smoke.mjs",
    "prepublishOnly": "node build.mjs && node test/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "altium",
    "altium-designer",
    "pcb",
    "eda",
