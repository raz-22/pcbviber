    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raz-22/pcbviber.git",
    "directory": "apps/local"
  },
  "homepage": "https://github.com/raz-22/pcbviber#readme",
  "bugs": {
    "url": "https://github.com/raz-22/pcbviber/issues"
  },
  "mcpName": "io.github.raz-22/pcbviber",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@altium-mcp/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.7",
    "esbuild": "^0.27.7",
    "zod": "^4.6.6"
  }
