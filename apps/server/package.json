{
  "name": "@altium-mcp/server",
  "version": "0.2.0",
  "description": "MCP Server for Altium 365 + Altium Designer — stdio and HTTP transports",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "altium-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node --env-file=../../.env build/index.js",
    "start:http": "node --env-file=../../.env build/index.js --transport=http",
    "inspect": "npx @anthropic-ai/mcp-inspector build/index.js"
  },
  "dependencies": {
    "@altium-mcp/shared": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fastify": "^5.0.0",
    "graphql-request": "^7.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
