{
  "name": "@altium-mcp/server",
  "version": "0.2.0",
  "description": "MCP Server for Altium 365 + Altium Designer — stdio and HTTP transports",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "altium-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node --env-file=../../.env build/index.js",
    "start:http": "node --env-file=../../.env build/index.js --transport=http",
    "run-job": "node --env-file=../../.env build/jobs/run-once.js",
    "inspect": "npx @anthropic-ai/mcp-inspector build/index.js",
    "test": "cross-env NODE_ENV=test node --test --experimental-test-coverage --test-reporter=spec \"build/**/*.test.js\""
  },
  "dependencies": {
    "@altium-mcp/auth": "workspace:*",
    "@altium-mcp/billing": "workspace:^",
    "@altium-mcp/db": "workspace:*",
    "@altium-mcp/metering": "workspace:*",
    "@altium-mcp/shared": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.0",
    "@fastify/csrf-protection": "^7.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@sentry/core": "^10.50.0",
    "@sentry/node": "^10.50.0",
    "bullmq": "^5.30.0",
    "fastify": "^5.0.0",
    "graphql-request": "^7.1.0",
    "ioredis": "^5.4.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.7",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "ioredis-mock": "^8.9.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
